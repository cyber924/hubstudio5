{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index?__route=/api/$1"
    },
    {
      "src": "/(robots.txt|sitemap.xml)",
      "dest": "/api/index?__route=/$1"
    },
    {
      "src": "/",
      "dest": "/api/index?__route=/"
    },
    {
      "src": "/(webzine|blog)",
      "dest": "/api/index?__route=/$1"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/api/index?__route=/blog/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "installCommand": "npm ci"
}
