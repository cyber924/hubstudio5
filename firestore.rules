rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Existing ImageHub images collection
    match /images/{imageId} {
      // Allows anyone to read public images
      allow read, list: if resource == null || resource.data.visibility == 'public';
    }

    // Hub5 Posts
    match /hub5Posts/{postId} {
      allow get, list: if resource.data.status == 'published'
        || (request.auth != null && resource.data.owner == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.id is int
        && request.resource.data.status in ['draft', 'published'];

      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && (
          // Allow full updates (saving/publishing)
          request.resource.data.status in ['draft', 'published', 'deleted']
        );

      allow delete: if false; // Soft deletes only (status = 'deleted')
    }

    // Hub5 ID Counter
    match /hub5Counters/{counterId} {
      // Allow authenticated users to get or update the post counter
      allow get, update: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Hub5 Private Reviews (accessible only by post owner)
    match /hub5Posts/{postId}/private/review {
      allow read, write: if request.auth != null 
        && get(/databases/$(database)/documents/hub5Posts/$(postId)).data.owner == request.auth.uid;
    }

    // Hub5 Revisions (accessible only by post owner, immutable once created)
    match /hub5Posts/{postId}/revisions/{versionId} {
      allow read: if request.auth != null 
        && get(/databases/$(database)/documents/hub5Posts/$(postId)).data.owner == request.auth.uid;
      
      allow create: if request.auth != null 
        && get(/databases/$(database)/documents/hub5Posts/$(postId)).data.owner == request.auth.uid;

      allow update, delete: if false; // Immutable
    }
  }
}
